# =============================================================================
# Daud Travel — Frontend (Next.js)
# Copy to:
#   - `frontend/.env.local`       for local development (`npm run dev`)
#   - `frontend/.env.production`  for docker-compose.prod.yml
#
# NEXT_PUBLIC_* values are inlined into the bundle at BUILD time, so rebuild
# after changing them. They are visible to anyone, so never put secrets here.
# =============================================================================

# Backend origin, no trailing slash and no `/api` (the app appends `/api`
# for requests and prefixes upload paths like `/uploads/...` for images).
NEXT_PUBLIC_BASE_URL=http://localhost:4000
# NEXT_PUBLIC_BASE_URL=https://api.daudtravel.com

# Web3Forms access key for the contact form (https://web3forms.com).
# Without it the contact form shows an error instead of sending.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=70f28dc1-2baa-43f4-9064-44635ab8107b
