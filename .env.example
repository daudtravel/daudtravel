# =============================================================================
# Daud Travel — Docker Compose (repo root)
# Copy to `.env` next to docker-compose.prod.yml.
#
# Compose reads this file for `${...}` substitution in the compose files; it is
# NOT passed into the containers. Service settings live in `backend/.env` and
# `frontend/.env.production` (see the .env.example in each folder).
# =============================================================================

# Passed as a build arg to the frontend image. Keep it the same as
# NEXT_PUBLIC_BASE_URL in frontend/.env.production.
NEXT_PUBLIC_BASE_URL=https://api.daudtravel.com
