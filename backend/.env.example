# =============================================================================
# Daud Travel — Backend (NestJS)
# Copy to `backend/.env` and fill in the values.
#   - Loaded by the app (ConfigModule) and by Prisma CLI (prisma.config.ts,
#     which prefers `backend/.env.local` if it exists).
#   - docker-compose.dev.yml / docker-compose.prod.yml pass this file via
#     `env_file` and override DATABASE_URL (and NODE_ENV in prod).
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Port the API listens on. Keep 4000 when running in Docker (ports + healthcheck).
PORT=4000

# Public origin of this API, no trailing slash and no `/api`.
# Used to build Bank of Georgia callback URLs (must be reachable by BOG, so use
# a tunnel such as ngrok when testing payments locally) and passport photo links
# in admin emails.
BASE_URL=http://localhost:4000

# Allowed frontend origins, comma-separated, no trailing slashes.
# All entries are allowed by CORS; the FIRST entry is used for payment
# redirects and links in emails.
FRONTEND_URL=http://localhost:3000
# FRONTEND_URL=https://www.daudtravel.com,https://daudtravel.com

# -----------------------------------------------------------------------------
# Database (PostgreSQL / Prisma)
# -----------------------------------------------------------------------------
# Running the backend on your machine against the dev compose Postgres (port 5433).
# Inside Docker Compose this is overridden to postgres:5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/daudtravel?schema=public

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Secret used to sign and verify JWT access tokens. Use a long random string,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Admin account created by `npm run seed` (ADMIN_EMAIL and ADMIN_PASSWORD are required).
# ADMIN_EMAIL is also the recipient of quick-payment order notifications and the
# default insurance notification email.
ADMIN_EMAIL=admin@daudtravel.com
ADMIN_PASSWORD=change-me
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Basic-auth login for GET /api/insurance/view-passport/:submissionId/:personId
# (the browser prompts for it). If unset, that endpoint rejects every request.
PASSPORT_VIEWER_USER=
PASSPORT_VIEWER_PASSWORD=

# -----------------------------------------------------------------------------
# Email (Resend) — https://resend.com
# -----------------------------------------------------------------------------
# Required: the app fails to start without it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender address; must belong to a domain verified in Resend.
RESEND_FROM_EMAIL=noreply@daudtravel.com

# -----------------------------------------------------------------------------
# Payments (Bank of Georgia e-commerce API)
# -----------------------------------------------------------------------------
# OAuth client credentials from the BOG merchant portal. Required for tour,
# transfer, quick-payment and insurance checkouts.
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
